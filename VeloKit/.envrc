# Let Nix provide the pinned Zig toolchain when no explicit override is set.
case "${DEVELOPER_DIR:-}" in
    ""|/nix/store/*) velokit_requested_developer_dir="" ;;
    *) velokit_requested_developer_dir="$DEVELOPER_DIR" ;;
esac
if [ -n "${VELOKIT_ZIG_HOME:-}" ]; then
    PATH_add "$VELOKIT_ZIG_HOME"
else
    use flake
fi

# Restore an explicit developer directory or prefer a full Xcode installation
# after the flake has set its SDK-oriented defaults.
if [ -n "$velokit_requested_developer_dir" ]; then
    export DEVELOPER_DIR="$velokit_requested_developer_dir"
elif [ -n "${VELOKIT_DEVELOPER_DIR:-}" ]; then
    export DEVELOPER_DIR="$VELOKIT_DEVELOPER_DIR"
else
    case "${DEVELOPER_DIR:-}" in
        ""|/nix/store/*)
            for candidate in \
                /Applications/Xcode.app/Contents/Developer \
                /Applications/Xcode-beta.app/Contents/Developer
            do
                if [ -d "$candidate" ]; then
                    export DEVELOPER_DIR="$candidate"
                    break
                fi
            done
            ;;
    esac
fi
unset velokit_requested_developer_dir
